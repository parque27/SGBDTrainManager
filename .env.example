REDIS_PORT=6379
REDISINSIGHT_PORT=5540
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=ocemt
BACKEND_PORT=8080
FRONTEND_PORT=8100
DATA_SOURCE=sim
# Backend: hosts used when the server runs outside Docker (in compose they are set to postgres / redis)
POSTGRES_HOST=localhost
REDIS_HOST=localhost
# Default Redis TTL in seconds for cached responses
CACHE_DEFAULT_TTL=300